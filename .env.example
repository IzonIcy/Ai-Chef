# OpenAI API key (required for the hosted API)
# Get yours from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: any OpenAI-compatible endpoint, such as a local Ollama server.
# OPENAI_BASE_URL=http://localhost:11434/v1

# Optional: Custom model override
# OPENAI_MODEL=gpt-4o
